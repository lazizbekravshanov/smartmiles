# SmartMiles environment template. Copy to `.env` and fill in real values.

# Telegram (BotFather token)
TELEGRAM_BOT_TOKEN=

# Database
DATABASE_URL=postgresql://user:password@host:5432/smartmiles

# Routing APIs
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
OPENROUTE_API_KEY=
OPENROUTE_BASE_URL=https://api.openrouteservice.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SmartMiles/0.1 (+https://github.com/your-org/smartmiles)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Tolls are computed from OpenStreetMap toll-road tags + a static turnpike rate table —
# no external paid API needed.

# Optional
REDIS_URL=
LOG_LEVEL=info

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
